# Pentarchy Vial PWA — document root of app.ap3p-fitness.com ONLY.
# This subdomain has its own folder, so these rules never touch the main
# WordPress site, WooCommerce, /wp-json/, the GLP connector, crypto endpoints
# or the private shipping-label storage.

Options -MultiViews -Indexes
DirectoryIndex index.html

AddType application/manifest+json .webmanifest
AddType application/javascript .js

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pass the Authorization header through to PHP (needed for member sessions).
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # API → PHP proxy (same-domain /api/glp/*)
  RewriteRule ^api/glp/(.*)$ api/glp.php?__route=$1 [QSA,L]
  RewriteRule ^api/glp/?$ api/glp.php?__route= [QSA,L]

  # Real files/folders are served as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Never fall back to the app for unknown API or asset paths.
  RewriteRule ^(api|_expo|assets|icons)/ - [R=404,L]

  # Single-page app fallback: deep links / refresh (e.g. /order/275) → index.html
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Always fresh: entry HTML, service worker, manifest.
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # Content-hashed bundles + bundled assets: cache for a year.
  <If "%{REQUEST_URI} =~ m#^/(_expo/static|assets)/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#^/icons/#">
    Header set Cache-Control "public, max-age=604800"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
